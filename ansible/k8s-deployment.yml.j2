apiVersion: apps/v1
kind: Deployment
metadata:
  name: xyz-app
spec:
  replicas: 5
  selector:
    matchLabels:
      app: xyz-app
  template:
    metadata:
      labels:
        app: xyz-app
    spec:
      containers:
        - name: xyz-app
          image: {{ image }}:{{ tag }}
          ports:
            - containerPort: 8080
          env:
            - name: APP_VERSION
              value: "{{ tag }}"
          readinessProbe:
            httpGet:
              path: /health
              port: 8080
            initialDelaySeconds: 5
            periodSeconds: 5
---
apiVersion: v1
kind: Service
metadata:
  name: xyz-service
spec:
  type: LoadBalancer
  selector:
    app: xyz-app
  ports:
    - port: 80
      targetPort: 8080
